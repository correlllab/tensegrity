+#include "mjpc/tasks/tensegrity/stand/stand.h"
+
+#include <string>
+#include <vector>
+
+#include <mujoco/mujoco.h>
+#include "mjpc/task.h"
+#include "mjpc/utilities.h"
+
+namespace mjpc {
+namespace tensegrity {
+
+namespace {
+constexpr double kTensionMin = 25.0;    // N, hide quiet cables
+constexpr double kTensionScale = 5e-4;  // m per N of arrow length
+constexpr double kGrfScale = 1.2e-3;    // m per N
+constexpr double kTorqueMin = 3.0;      // Nm
+constexpr double kTorqueScale = 2e-3;   // m per Nm
+
+void AddArrow(mjvScene* scene, const mjtNum from[3], const mjtNum to[3],
+              double width, const float rgba[4]) {
+  if (scene->ngeom >= scene->maxgeom) return;
+  mjvGeom* g = scene->geoms + scene->ngeom;
+  mjv_initGeom(g, mjGEOM_ARROW, nullptr, nullptr, nullptr, rgba);
+  g->emission = 0.7;
+  mjv_connector(g, mjGEOM_ARROW, width, from, to);
+  scene->ngeom++;
+}
+}  // namespace
+
+void ForceArrowViz(const mjModel* m, const mjData* d, mjvScene* scn) {
+  // ---- cable tensions: active (tendon actuators) + passive spring/damper
+  std::vector<double> tension(m->ntendon, 0.0);
+  for (int i = 0; i < m->nu; i++) {
+    if (m->actuator_trntype[i] == mjTRN_TENDON) {
+      tension[m->actuator_trnid[2 * i]] +=
+          -(m->actuator_gear[6 * i] * d->actuator_force[i]);
+    }
+  }
+  for (int t = 0; t < m->ntendon; t++) {
+    double stretch = d->ten_length[t] - m->tendon_lengthspring[2 * t];
+    double passive = m->tendon_stiffness[t] * stretch +
+                     m->tendon_damping[t] * d->ten_velocity[t];
+    double T = tension[t] + mju_max(0.0, passive);
+    if (T < kTensionMin) continue;
+    int adr = d->ten_wrapadr[t];
+    int num = d->ten_wrapnum[t];
+    const mjtNum* p0 = d->wrap_xpos + 3 * adr;
+    const mjtNum* p1 = d->wrap_xpos + 3 * (adr + num - 1);
+    mjtNum u[3];
+    mju_sub3(u, p1, p0);
+    mju_normalize3(u);
+    double len = mju_clip(kTensionScale * T, 0.04, 0.30);
+    float frac = (float)mju_min(1.0, T / 500.0);
+    float rgba[4] = {frac, 1.0f - frac, 0.15f, 1.0f};
+    mjtNum to[3];
+    mju_addScl3(to, p0, u, len);
+    AddArrow(scn, p0, to, 0.009, rgba);
+    mju_addScl3(to, p1, u, -len);
+    AddArrow(scn, p1, to, 0.009, rgba);
+  }
+
+  // ---- per-foot net ground-reaction force at the center of pressure
+  const char* feet[2] = {"foot_l_geom", "foot_r_geom"};
+  for (const char* fname : feet) {
+    int gid = mj_name2id(m, mjOBJ_GEOM, fname);
+    if (gid < 0) continue;
+    mjtNum F[3] = {0, 0, 0};
+    mjtNum cop[3] = {0, 0, 0};
+    double wsum = 0.0;
+    for (int i = 0; i < d->ncon; i++) {
+      const mjContact& c = d->contact[i];
+      if (c.geom[0] != gid && c.geom[1] != gid) continue;
+      mjtNum f6[6];
+      mj_contactForce(m, d, i, f6);
+      mjtNum fw[3];
+      mju_mulMatTVec(fw, c.frame, f6, 3, 3);
+      if (c.geom[0] == gid) mju_scl3(fw, fw, -1.0);
+      mju_addTo3(F, fw);
+      double w = mju_abs(fw[2]) + 1e-9;
+      mju_addToScl3(cop, c.pos, w);
+      wsum += w;
+    }
+    if (wsum > 1e-6 && mju_norm3(F) > 5.0) {
+      mju_scl3(cop, cop, 1.0 / wsum);
+      if (F[2] < 0) mju_scl3(F, F, -1.0);
+      mjtNum to[3];
+      mju_addScl3(to, cop, F, kGrfScale);
+      float rgba[4] = {1.0f, 0.55f, 0.05f, 1.0f};
+      AddArrow(scn, cop, to, 0.016, rgba);
+    }
+  }
+
+  // ---- joint-actuator torques along hinge axes (joint-transmission models)
+  for (int i = 0; i < m->nu; i++) {
+    if (m->actuator_trntype[i] != mjTRN_JOINT) continue;
+    int j = m->actuator_trnid[2 * i];
+    if (m->jnt_type[j] != mjJNT_HINGE) continue;
+    double torque = m->actuator_gear[6 * i] * d->actuator_force[i];
+    if (mju_abs(torque) < kTorqueMin) continue;
+    const mjtNum* axis = d->xaxis + 3 * j;
+    const mjtNum* anchor = d->xanchor + 3 * j;
+    double len = mju_clip(kTorqueScale * mju_abs(torque), 0.03, 0.25);
+    mjtNum to[3];
+    mju_addScl3(to, anchor, axis, torque > 0 ? len : -len);
+    float rgba[4] = {0.1f, 0.8f, 1.0f, 1.0f};
+    AddArrow(scn, anchor, to, 0.008, rgba);
+  }
+}
+
+std::string Stand::XmlPath() const {
+  return GetModelPath("tensegrity/task_stand.xml");
+}
+std::string Stand::Name() const { return "Tensegrity Stand"; }
+
+void Stand::ModifyScene(const mjModel* model, const mjData* data,
+                        mjvScene* scene) const {
+  ForceArrowViz(model, data, scene);
+}
+
+void Stand::ResidualFn::Residual(const mjModel* model, const mjData* data,
+                                 double* residual) const {
+  int counter = 0;
+
+  // ----- Height: head-feet vertical error ----- //
+  double* f1_position = SensorByName(model, data, "sp0");
+  double* f2_position = SensorByName(model, data, "sp1");
+  double* f3_position = SensorByName(model, data, "sp2");
+  double* f4_position = SensorByName(model, data, "sp3");
+  double* head_position = SensorByName(model, data, "head_position");
+  double head_feet_error =
+      head_position[2] - 0.25 * (f1_position[2] + f2_position[2] +
+                                 f3_position[2] + f4_position[2]);
+  residual[counter++] = head_feet_error - parameters_[0];
+
+  // ----- Balance: capture point - feet center xy ----- //
+  double* com_position = SensorByName(model, data, "torso_subtreecom");
+  double* com_velocity = SensorByName(model, data, "torso_subtreelinvel");
+  double kFallTime = 0.2;
+  double capture_point[3] = {com_position[0], com_position[1], com_position[2]};
+  mju_addToScl3(capture_point, com_velocity, kFallTime);
+
+  double fxy_avg[2] = {0.0};
+  mju_addTo(fxy_avg, f1_position, 2);
+  mju_addTo(fxy_avg, f2_position, 2);
+  mju_addTo(fxy_avg, f3_position, 2);
+  mju_addTo(fxy_avg, f4_position, 2);
+  mju_scl(fxy_avg, fxy_avg, 0.25, 2);
+
+  mju_subFrom(fxy_avg, capture_point, 2);
+  double com_feet_distance = mju_norm(fxy_avg, 2);
+  residual[counter++] = com_feet_distance;
+
+  // ----- stance geometry ----- //
+  // Everything here is expressed in the pelvis frame (its x = forward, y =
+  // left), so "width" stays lateral and "offset" stays fore/aft even when the
+  // robot has yawed. Using world x/y instead would silently reward a splayed
+  // stance as soon as the robot turned.
+  double* foot_l = SensorByName(model, data, "foot_left");
+  double* foot_r = SensorByName(model, data, "foot_right");
+  double* pelvis_fwd = SensorByName(model, data, "pelvis_forward");
+  double* pelvis_left = SensorByName(model, data, "pelvis_left");
+  double* foot_l_fwd = SensorByName(model, data, "foot_left_forward");
+  double* foot_r_fwd = SensorByName(model, data, "foot_right_forward");
+  double* foot_l_up = SensorByName(model, data, "foot_left_up");
+  double* foot_r_up = SensorByName(model, data, "foot_right_up");
+
+  double between[3];
+  mju_sub3(between, foot_l, foot_r);          // right foot -> left foot
+
+  // Stance width: signed lateral separation. The residual is
+  // (minimum - actual) and the cost uses the RECTIFY norm, so it pushes back
+  // only when the feet are too close together and leaves a wider stance free.
+  // A quadratic here would pin the width to an exact value instead.
+  residual[counter++] = parameters_[1] - mju_dot3(between, pelvis_left);
+
+  // Fore/aft: neither foot ahead of the other.
+  residual[counter++] = mju_dot3(between, pelvis_fwd);
+
+  // Feet parallel to each other: vertical component of the cross product of
+  // the two forward axes is sin(angle between them), zero when parallel.
+  double cross_fwd[3];
+  mju_cross(cross_fwd, foot_l_fwd, foot_r_fwd);
+  residual[counter++] = cross_fwd[2];
+
+  // Feet flat on the ground.
+  residual[counter++] = foot_l_up[2] - 1.0;
+  residual[counter++] = foot_r_up[2] - 1.0;
+
+  // Feet square to the body: a foot pointing straight ahead has no component
+  // along the pelvis lateral axis. Penalises toe-out/toe-in.
+  residual[counter++] = mju_dot3(foot_l_fwd, pelvis_left);
+  residual[counter++] = mju_dot3(foot_r_fwd, pelvis_left);
+
+  // ----- CoM xy velocity ----- //
+  mju_copy(&residual[counter], com_velocity, 2);
+  counter += 2;
+
+  // ----- joint velocity ----- //
+  mju_copy(residual + counter, data->qvel + 6, model->nv - 6);
+  counter += model->nv - 6;
+
+  // ----- control ----- //
+  mju_copy(&residual[counter], data->ctrl, model->nu);
+  counter += model->nu;
+
+  // sensor dim sanity check
+  int user_sensor_dim = 0;
+  for (int i = 0; i < model->nsensor; i++) {
+    if (model->sensor_type[i] == mjSENS_USER) {
+      user_sensor_dim += model->sensor_dim[i];
+    }
+  }
+  if (user_sensor_dim != counter) {
+    mju_error_i(
+        "mismatch between total user-sensor dimension "
+        "and actual length of residual %d",
+        counter);
+  }
+}
+
+}  // namespace tensegrity
+}  // namespace mjpc
