+<mujoco model="Tensegrity Humanoid Cable Stand">
+  <include file="../common.xml"/>
+  <include file="humanoid_27dof_tensegrity_cable.xml"/>
+  <size memory="8M"/>
+
+  <custom>
+    <numeric name="agent_planner" data="0" />
+    <numeric name="agent_horizon" data="0.35" />
+    <numeric name="agent_timestep" data="0.015" />
+    <numeric name="sampling_spline_points" data="3" />
+    <numeric name="sampling_exploration" data="0.05" />
+    <numeric name="gradient_spline_points" data="5" />
+    <numeric name="residual_Height Goal" data="1.51 0.5 1.65" />
+    <numeric name="residual_Stance Width" data="0.20 0.08 0.45" />
+  </custom>
+
+  <!-- Stance weights are ~4x lower than the joint-torque task: with 114
+       tension controls the sampling planner is already at its budget just
+       balancing, and full-strength stance costs tip it over. It stands, but
+       only partly achieves the stance. -->
+  <sensor>
+    <!-- cost terms; order and dims must match stand.cc residual -->
+    <user name="Height" dim="1" user="6 100.0 0.0 100.0 0.1" />
+    <user name="Balance" dim="1" user="6 50.0 0.0 100.0 0.1" />
+    <user name="Stance Width" dim="1" user="0 8.0 0.0 200.0" />
+    <user name="Stance Offset" dim="1" user="0 2.0 0.0 100.0" />
+    <user name="Feet Parallel" dim="1" user="0 2.0 0.0 100.0" />
+    <user name="Feet Flat" dim="2" user="0 2.5 0.0 100.0" />
+    <user name="Feet Square" dim="2" user="0 1.0 0.0 100.0" />
+    <user name="CoM Vel." dim="2" user="0 10.0 0.0 100.0" />
+    <user name="Joint Vel." dim="27" user="0 0.01 0.0 0.1" />
+    <user name="Control" dim="114" user="3 0.025 0.0 0.1 0.3" />
+
+    <!-- trace -->
+    <framepos name="trace0" objtype="body" objname="torso"/>
+
+    <!-- residual -->
+    <framepos name="head_position" objtype="body" objname="head"/>
+    <subtreecom name="torso_subtreecom" body="pelvis"/>
+    <subtreelinvel name="torso_subtreelinvel" body="pelvis"/>
+    <framepos name="foot_left" objtype="body" objname="foot_l"/>
+    <framepos name="foot_right" objtype="body" objname="foot_r"/>
+    <framexaxis name="pelvis_forward" objtype="xbody" objname="pelvis"/>
+    <frameyaxis name="pelvis_left" objtype="xbody" objname="pelvis"/>
+    <framexaxis name="foot_left_forward" objtype="xbody" objname="foot_l"/>
+    <framexaxis name="foot_right_forward" objtype="xbody" objname="foot_r"/>
+    <framezaxis name="foot_left_up" objtype="xbody" objname="foot_l"/>
+    <framezaxis name="foot_right_up" objtype="xbody" objname="foot_r"/>
+    <framepos name="sp0" objtype="site" objname="sp0"/>
+    <framepos name="sp1" objtype="site" objname="sp1"/>
+    <framepos name="sp2" objtype="site" objname="sp2"/>
+    <framepos name="sp3" objtype="site" objname="sp3"/>
+  </sensor>
+</mujoco>
diff --git a/mjpc/tasks/tensegrity/task_hybrid_walk.xml b/mjpc/tasks/tensegrity/task_hybrid_walk.xml
new file mode 100644
index 0000000..abd2c9d
--- /dev/null
+++ b/mjpc/tasks/tensegrity/task_hybrid_walk.xml
@@ -0,0 +1,53 @@
+<mujoco model="Hybrid Tensegrity Walk">
+  <include file="../common.xml"/>
+  <include file="humanoid_hybrid.xml"/>
+  <size memory="8M"/>
+
+  <custom>
+    <!-- iLQG; agent timestep 10 ms because the ankle cable stiffness sets a
+         ~200 rad/s mode on the feet, which a 20 ms explicit-spring rollout
+         cannot integrate -->
+    <numeric name="agent_planner" data="2" />
+    <numeric name="agent_plan_enabled" data="1" />
+    <numeric name="agent_horizon" data="0.42" />
+    <numeric name="agent_timestep" data="0.008" />
+    <numeric name="sampling_spline_points" data="4" />
+    <numeric name="sampling_exploration" data="0.06" />
+    <numeric name="gradient_spline_points" data="5" />
+
+    <numeric name="residual_Torso" data="1.20 1.00 1.40" />
+    <numeric name="residual_Speed" data="0.45 -0.5 1.0" />
+    <numeric name="residual_Cadence" data="0.8 0.5 2.5" />
+    <numeric name="residual_Step Height" data="0.24 0.0 0.30" />
+    <numeric name="residual_Stance Width" data="0.20 0.10 0.40" />
+    <numeric name="residual_Sway" data="0.06 0.0 0.12" />
+  </custom>
+
+  <sensor>
+    <!-- cost terms; order and dims must match hybrid.cc residual -->
+    <user name="Height"    dim="1"  user="7 5.0 0 25.0 0.1 4.0" />
+    <user name="Balance"   dim="2"  user="1 3.0 0.0 25.0 0.02 4.0" />
+    <user name="Upright"   dim="8"  user="2 5.0 0.0 25.0 0.01" />
+    <user name="Sway"      dim="1"  user="0 40.0 0.0 200.0" />
+    <user name="Posture"   dim="12" user="0 1.0 0 10.0" />
+    <user name="Speed"     dim="1"  user="7 4.0 0.0 25.0 0.3 3.0" />
+    <user name="Straight"  dim="1"  user="0 3.0 0.0 50.0" />
+    <user name="Gait"      dim="6"  user="0 50.0 0.0 200.0" />
+    <user name="Control"   dim="30" user="3 0.08 0 1.0 0.3" />
+
+    <framepos name="trace0" objtype="body" objname="torso"/>
+
+    <framepos name="torso_position" objtype="body" objname="torso"/>
+    <framepos name="pelvis_position" objtype="body" objname="pelvis"/>
+    <framepos name="foot_left" objtype="body" objname="foot_l"/>
+    <framepos name="foot_right" objtype="body" objname="foot_r"/>
+    <subtreecom name="torso_subcom" body="world"/>
+    <subtreelinvel name="torso_subcomvel" body="world"/>
+    <framexaxis name="pelvis_forward" objtype="xbody" objname="pelvis"/>
