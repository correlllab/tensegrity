--- /dev/null
+++ b/mjpc/tasks/tensegrity/stand/stand.cc
@@ -0,0 +1,237 @@
+// Copyright 2022 DeepMind Technologies Limited
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
