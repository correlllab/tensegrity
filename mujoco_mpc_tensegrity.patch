diff --git a/mjpc/agent.cc b/mjpc/agent.cc
index 2c3f372..3e164bc 100644
--- a/mjpc/agent.cc
+++ b/mjpc/agent.cc
@@ -129,8 +129,11 @@ void Agent::Initialize(const mjModel* model) {
   ctrl.resize(model->nu);
   sensor.resize(model->nsensordata);
 
-  // status
-  plan_enabled = false;
+  // status. A task can opt into planning-on-load with
+  //   <numeric name="agent_plan_enabled" data="1"/>
+  // (same convention as agent_planner / agent_horizon); the
+  // --planner_enabled CLI flag can still force it on.
+  plan_enabled = GetNumberOrDefault(0, model, "agent_plan_enabled");
   action_enabled = true;
   visualize_enabled = false;
   allocate_enabled = true;
diff --git a/mjpc/app.cc b/mjpc/app.cc
index 69c7601..3f4c5fd 100644
--- a/mjpc/app.cc
+++ b/mjpc/app.cc
@@ -228,7 +228,9 @@ void PhysicsLoop(mj::Simulate& sim) {
       if (dnew) {
         sim.agent->Initialize(mnew);
         sim.agent->plot_enabled = absl::GetFlag(FLAGS_show_plot);
-        sim.agent->plan_enabled = absl::GetFlag(FLAGS_planner_enabled);
+        if (absl::GetFlag(FLAGS_planner_enabled)) {
+          sim.agent->plan_enabled = true;
+        }
         sim.agent->Allocate();
 
         // set home keyframe
@@ -437,7 +439,9 @@ MjpcApp::MjpcApp(std::vector<std::shared_ptr<mjpc::Task>> tasks, int task_id) {
   sim->agent->Reset();
   sim->agent->PlotInitialize();
 
-  sim->agent->plan_enabled = absl::GetFlag(FLAGS_planner_enabled);
+  if (absl::GetFlag(FLAGS_planner_enabled)) {
+    sim->agent->plan_enabled = true;
+  }
 
   // Get the index of the closest sim percentage to the input.
   float desired_percent = absl::GetFlag(FLAGS_sim_percent_realtime);
