+#ifndef MJPC_TASKS_TENSEGRITY_WALK_TASK_H_
+#define MJPC_TASKS_TENSEGRITY_WALK_TASK_H_
+
+#include <memory>
+#include <string>
+
+#include <mujoco/mujoco.h>
+#include "mjpc/task.h"
+
+namespace mjpc {
+namespace tensegrity {
+
+// Walk task for the 27-DoF apparel-mounted tensegrity humanoid (M0 model).
+class Walk : public Task {
+ public:
+  class ResidualFn : public mjpc::BaseResidualFn {
+   public:
+    explicit ResidualFn(const Walk* task) : mjpc::BaseResidualFn(task) {}
+
+    // -------- Residuals for tensegrity humanoid walk task ---------
+    //   Residual (0): torso height                        1
+    //   Residual (1): balance, capture point              2
+    //   Residual (2): upright                             8
+    //   Residual (3): posture                             nq-7
+    //   Residual (4): forward speed along the heading     1
+    //   Residual (5): lateral weight-shift (sway) track   1
+    //   Residual (6): heading yaw drift                    1
+    //   Residual (7): cartesian gait tracking              6
+    //   Residual (8): control                              nu
+    //   Parameter (0): torso height goal
+    //   Parameter (1): speed goal (m/s)
+    //   Parameter (2): cadence (gait cycles/s)
+    //   Parameter (3): step height (m)
+    //   Parameter (4): stance width (m)
+    //   Parameter (5): sway amplitude (m)
+    // --------------------------------------------------------------
+    void Residual(const mjModel* model, const mjData* data,
+                  double* residual) const override;
+
+    // Prescribed foot position in the pelvis frame at a given gait phase.
+    static void FootTarget(double phase, double speed, double cadence,
+                           double step_height, double* fwd, double* lift,
+                           double* swing);
+  };
+
+  Walk() : residual_(this) { visualize = 1; }
+
+  std::string Name() const override;
+  std::string XmlPath() const override;
+  void ModifyScene(const mjModel* model, const mjData* data,
+                   mjvScene* scene) const override;
+
+ protected:
