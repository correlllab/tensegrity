+#include "mjpc/tasks/tensegrity/walk/walk.h"
+
+#include <cmath>
+#include <string>
+
+#include <mujoco/mujoco.h>
+#include "mjpc/task.h"
+#include "mjpc/tasks/tensegrity/stand/stand.h"
+#include "mjpc/utilities.h"
+
+namespace mjpc {
+namespace tensegrity {
+
+// The residual tracks an ANALYTIC WALKING REFERENCE generated right here:
+// lateral pelvis sway (LIPM-style weight shift), treadmill footstep targets,
+// and closed-form leg IK turning those into 12 leg-joint references, plus
+// counter-swinging arms. Cost shaping alone (speed + balance + "keep feet
+// moving") produced marching in place: two of its terms were actively
+// anti-walking — a straight-line cost that pinned the pelvis to y = 0
+// (forbidding the weight shift that unloads a foot), and a capture-point cost
+// forever centring the CoM between the feet (wrong during single support).
+// Tracking a consistent reference removes both conflicts; MPC's job reduces
+// to cleaning up what the reference gets wrong dynamically.
+
+namespace {
+// Foot body origin height with the sole on the ground.
+constexpr double kFootPlantedZ = 0.076;
+// Stance fraction of the cycle. > 0.5 means double support around each
+// step - a walk, not a run.
+constexpr double kDutyRatio = 0.65;
+// Raibert gain: landing-point bias per unit CoM velocity error.
+constexpr double kCaptureGain = 0.28;
+// Sway leads the swing phases so the weight is already over the stance foot
+// when the other lifts (peaks at phase 0.32 / 0.82; swings start 0.15 / 0.65).
+constexpr double kSwayPhaseLead = 0.07;
+// Arm counter-swing amplitude (rad) and elbow reference.
+constexpr double kArmSwing = 0.25;
+constexpr double kElbowRef = -0.3;
+// Leg geometry: hip centres relative to the pelvis origin, segment lengths.
+constexpr double kHipY = 0.09;
+constexpr double kHipZ = -0.06;
+constexpr double kThigh = 0.40;
+constexpr double kShank = 0.40;
+// Torso body origin sits 0.10 above the pelvis origin.
+constexpr double kTorsoAbovePelvis = 0.10;
+
+// Closed-form flat-foot leg IK, verified to < 0.1 mm against model FK.
+// ankle = foot body origin relative to the PELVIS origin. Angles follow the
+// model's sign conventions (hip_pitch < 0 flexes forward, knee > 0 flexes,
+// flat sole <=> pitch angles sum to zero and rolls cancel).
+void LegIK(double side, const double ankle[3], double* hip_roll,
+           double* hip_pitch, double* knee, double* ankle_pitch,
+           double* ankle_roll) {
+  double d[3] = {ankle[0], ankle[1] - side * kHipY, ankle[2] - kHipZ};
+  double roll = std::atan2(d[1], -d[2]);
+  double D2 = d[0] * d[0] + d[1] * d[1] + d[2] * d[2];
+  double reach = kThigh + kShank - 1e-6;
+  D2 = mju_min(D2, reach * reach);
+  double c = (kThigh * kThigh + kShank * kShank - D2) / (2 * kThigh * kShank);
+  double kn = mjPI - std::acos(mju_clip(c, -1.0, 1.0));
+  double D = mju_sqrt(D2);
+  double alpha = std::atan2(d[0], mju_sqrt(d[1] * d[1] + d[2] * d[2]));
+  double cb = (kThigh * kThigh + D2 - kShank * kShank) / (2 * kThigh * D);
+  double beta = std::acos(mju_clip(cb, -1.0, 1.0));
+  *hip_roll = roll;
+  *hip_pitch = -(alpha + beta);
+  *knee = kn;
+  *ankle_pitch = -(*hip_pitch + kn);
+  *ankle_roll = -roll;
+}
+}  // namespace
+
+std::string Walk::XmlPath() const {
+  return GetModelPath("tensegrity/task_walk.xml");
+}
+std::string Walk::Name() const { return "Tensegrity Walk"; }
+
+// Treadmill foot target in the pelvis frame at gait phase `phase`:
+// stance foot slides backward under a pelvis moving at `speed`, swing foot
+// returns with a sine clearance arc. `swing` ramps 0 -> 1 across the swing so
+// feedback corrections fade in without a jump at lift-off.
+void Walk::ResidualFn::FootTarget(double phase, double speed, double cadence,
+                                  double step_height, double* fwd,
+                                  double* lift, double* swing) {
+  double stride = speed * kDutyRatio / std::fmax(1e-6, cadence);
+  if (phase < kDutyRatio) {
+    double s = phase / kDutyRatio;
+    *fwd = 0.5 * stride - s * stride;
+    *lift = 0.0;
+    *swing = 0.0;
+  } else {
+    double s = (phase - kDutyRatio) / (1.0 - kDutyRatio);
+    *fwd = -0.5 * stride + s * stride;
+    *lift = step_height * mju_sin(mjPI * s);
+    *swing = s;
+  }
+}
+
+void Walk::ResidualFn::Residual(const mjModel* model, const mjData* data,
+                                double* residual) const {
+  int counter = 0;
+
+  double torso_ref = parameters_[0];
+  double speed = parameters_[1];
+  double cadence = parameters_[2];
+  double step_height = parameters_[3];
+  double stance_width = parameters_[4];
+  double sway_amp = parameters_[5];
+  double pelvis_z_ref = torso_ref - kTorsoAbovePelvis;
+
+  double* torso_pos = SensorByName(model, data, "torso_position");
+  double* pelvis_pos = SensorByName(model, data, "pelvis_position");
+  double* foot_l = SensorByName(model, data, "foot_left");
+  double* foot_r = SensorByName(model, data, "foot_right");
+  double* pelvis_fwd = SensorByName(model, data, "pelvis_forward");
+  double* subcom = SensorByName(model, data, "torso_subcom");
+  double* subcomvel = SensorByName(model, data, "torso_subcomvel");
+
+  // gait phase, identical in plant and rollouts (pure function of time)
+  double phase = std::fmod(data->time * cadence, 1.0);
+  if (phase < 0) phase += 1.0;
+  double y_ref = sway_amp * mju_sin(2 * mjPI * (phase - kSwayPhaseLead));
+
+  // ----- torso height ----- //
+  residual[counter++] = torso_pos[2] - torso_ref;
+
+  // ----- balance: capture point over the support segment ----- //
+  double capture_point[3];
+  mju_addScl(capture_point, subcom, subcomvel, 0.25, 3);
+  double axis[3], center[3], vec[3], pcp[3];
+  mju_sub3(axis, foot_r, foot_l);
+  axis[2] = 1.0e-3;
+  double length = 0.5 * mju_normalize3(axis) - 0.05;
+  mju_add3(center, foot_r, foot_l);
+  mju_scl3(center, center, 0.5);
+  mju_sub3(vec, capture_point, center);
+  double t = mju_clip(mju_dot3(vec, axis), -length, length);
+  mju_scl3(vec, axis, t);
+  mju_add3(pcp, vec, center);
+  double standing =
+      torso_pos[2] / mju_sqrt(torso_pos[2] * torso_pos[2] + 0.45 * 0.45) - 0.4;
+  mju_sub(&residual[counter], capture_point, pcp, 2);
+  mju_scl(&residual[counter], &residual[counter], standing, 2);
+  counter += 2;
+
+  // ----- upright ----- //
+  double* torso_up = SensorByName(model, data, "torso_up");
+  double* pelvis_up = SensorByName(model, data, "pelvis_up");
+  double* foot_l_up = SensorByName(model, data, "foot_left_up");
+  double* foot_r_up = SensorByName(model, data, "foot_right_up");
+  double z_ref_v[3] = {0.0, 0.0, 1.0};
+  residual[counter++] = torso_up[2] - 1.0;
+  residual[counter++] = 0.3 * (pelvis_up[2] - 1.0);
+  mju_sub3(&residual[counter], foot_r_up, z_ref_v);
+  mju_scl3(&residual[counter], &residual[counter], 0.1 * standing);
+  counter += 3;
+  mju_sub3(&residual[counter], foot_l_up, z_ref_v);
+  mju_scl3(&residual[counter], &residual[counter], 0.1 * standing);
+  counter += 3;
+
+  // ----- lateral weight shift: pelvis follows the sway reference ----- //
+  // This is the term the old cost got exactly backwards (it demanded y = 0).
+  residual[counter++] = pelvis_pos[1] - y_ref;
+
+  // ----- capture-point landing correction (shared by IK + cartesian) ----- //
+  double v_fwd = mju_dot3(subcomvel, pelvis_fwd);
+  double t_stance = kDutyRatio / mju_max(1e-6, cadence);
+  double corr_fwd =
+      mju_clip(0.5 * (v_fwd - speed) * t_stance + kCaptureGain * (v_fwd - speed),
+               -0.15, 0.15);
+  double corr_lat =
+      mju_clip(0.5 * subcomvel[1] * t_stance + kCaptureGain * subcomvel[1],
+               -0.10, 0.10);
+
+  // ----- per-leg reference: treadmill target -> flat-foot IK ----- //
+  double offs[2] = {0.0, 0.5};     // left, right
+  double sides[2] = {+1.0, -1.0};
+  const double* feet[2] = {foot_l, foot_r};
+  double leg_ref[2][6];            // hip_yaw, roll, pitch, knee, ankle_p, ankle_r
+  double cart[2][3];               // cartesian residuals per foot
+  for (int f = 0; f < 2; f++) {
+    double ph = std::fmod(phase + offs[f], 1.0);
+    double fwd_t, lift_t, swing;
+    FootTarget(ph, speed, cadence, step_height, &fwd_t, &lift_t, &swing);
+    fwd_t += swing * corr_fwd;
+    double lane = sides[f] * 0.5 * stance_width + swing * corr_lat;
+
+    // ankle target relative to the pelvis (world lanes, pelvis sway)
+    double ankle[3] = {fwd_t, lane - y_ref,
+                       kFootPlantedZ + lift_t - pelvis_z_ref};
+    leg_ref[f][0] = 0.0;
+    LegIK(sides[f], ankle, &leg_ref[f][1], &leg_ref[f][2], &leg_ref[f][3],
+          &leg_ref[f][4], &leg_ref[f][5]);
+
+    // cartesian tracking of the same target (helps iLQG shape contact)
+    double d[3];
+    mju_sub3(d, feet[f], pelvis_pos);
+    cart[f][0] = mju_dot3(d, pelvis_fwd) - fwd_t;
+    cart[f][1] = feet[f][1] - lane;                       // world lane
+    cart[f][2] = feet[f][2] - (kFootPlantedZ + lift_t);   // world height
+  }
+
+  // ----- posture: track the gait reference ----- //
+  // qpos[7..] order: 12 leg joints (L then R), 3 waist, 2 neck, 2x5 arm.
+  double s_arm = mju_sin(2 * mjPI * phase);
+  double qref[27] = {0};
+  for (int f = 0; f < 2; f++) {
+    for (int k = 0; k < 6; k++) qref[6 * f + k] = leg_ref[f][k];
+  }
+  double sh_l = -kArmSwing * s_arm;
+  double sh_r = +kArmSwing * s_arm;
+  qref[17] = sh_l; qref[20] = kElbowRef;   // L: pitch, roll, yaw, elbow, wrist
+  qref[22] = sh_r; qref[25] = kElbowRef;   // R
+  // legs carry the gait; everything else is tracked more loosely
+  for (int i = 0; i < 27; i++) {
+    double scale = i < 12 ? 1.0 : 0.5;
+    residual[counter++] = scale * (data->qpos[7 + i] - qref[i]);
+  }
+
+  // ----- forward speed along the heading ----- //
+  residual[counter++] = standing * (v_fwd - speed);
+
+  // ----- heading stays straight (yaw only; sway owns lateral) ----- //
+  residual[counter++] = pelvis_fwd[1];
+
+  // ----- cartesian gait tracking ----- //
+  for (int f = 0; f < 2; f++) {
+    residual[counter++] = cart[f][0];
+    residual[counter++] = cart[f][1];
+    residual[counter++] = cart[f][2];
+  }
+
+  // ----- control ----- //
+  mju_copy(&residual[counter], data->ctrl, model->nu);
+  counter += model->nu;
+
+  // sensor dim sanity check
+  int user_sensor_dim = 0;
+  for (int i = 0; i < model->nsensor; i++) {
+    if (model->sensor_type[i] == mjSENS_USER) {
+      user_sensor_dim += model->sensor_dim[i];
+    }
+  }
+  if (user_sensor_dim != counter) {
+    mju_error_i(
+        "mismatch between total user-sensor dimension "
+        "and actual length of residual %d",
+        counter);
+  }
+}
+
+void Walk::ModifyScene(const mjModel* model, const mjData* data,
+                       mjvScene* scene) const {
+  ForceArrowViz(model, data, scene);
+}
+
+}  // namespace tensegrity
+}  // namespace mjpc
