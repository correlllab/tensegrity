+#ifndef MJPC_TASKS_TENSEGRITY_STAND_TASK_H_
+#define MJPC_TASKS_TENSEGRITY_STAND_TASK_H_
+
+#include <memory>
+#include <string>
+
+#include <mujoco/mujoco.h>
+#include "mjpc/task.h"
+
+namespace mjpc {
+namespace tensegrity {
+
+// Draws live force arrows into the scene: cable tensions (green->red, at both
+// anchors of every loaded cable), per-foot net ground-reaction force at the
+// center of pressure (orange), and joint-actuator torques along hinge axes
+// (cyan; joint-transmission models only). Shared by all tensegrity tasks.
+void ForceArrowViz(const mjModel* model, const mjData* data, mjvScene* scene);
+
+// Stand task for the 27-DoF apparel-mounted tensegrity humanoid (M0 model).
+class Stand : public Task {
+ public:
+  class ResidualFn : public mjpc::BaseResidualFn {
+   public:
+    explicit ResidualFn(const Stand* task) : mjpc::BaseResidualFn(task) {}
+
+    // -------- Residuals for tensegrity humanoid stand task --------
+    //   Residual (0): head height above average foot corner sites
+    //   Residual (1): capture point - feet center xy distance
+    //   Residual (2): stance width shortfall (rectified: MINIMUM, not target)
+    //   Residual (3): fore/aft foot offset along the heading
+    //   Residual (4): feet parallel to each other
+    //   Residual (5): feet flat on the ground        (dim 2)
+    //   Residual (6): feet square to the body, no toe-out  (dim 2)
+    //   Residual (7): CoM xy velocity                (dim 2)
+    //   Residual (8): joint velocity
+    //   Residual (9): control
+    //   Parameter (0): height goal
+    //   Parameter (1): minimum stance width (m)
+    // All stance terms are measured in the PELVIS frame, so they still mean
+    // what they say when the robot turns.
+    // --------------------------------------------------------------
+    void Residual(const mjModel* model, const mjData* data,
+                  double* residual) const override;
+  };
+
+  // force-arrow overlay on by default (MJPC's Task::visualize
+  // defaults to 0; the GUI checkbox is Task > Visualize)
+  Stand() : residual_(this) { visualize = 1; }
+
+  std::string Name() const override;
+  std::string XmlPath() const override;
+  void ModifyScene(const mjModel* model, const mjData* data,
+                   mjvScene* scene) const override;
+
+ protected:
+  std::unique_ptr<mjpc::ResidualFn> ResidualLocked() const override {
+    return std::make_unique<ResidualFn>(this);
+  }
+  ResidualFn* InternalResidual() override { return &residual_; }
+
+ private:
+  ResidualFn residual_;
+};
+
+}  // namespace tensegrity
+}  // namespace mjpc
+
+#endif  // MJPC_TASKS_TENSEGRITY_STAND_TASK_H_
diff --git a/mjpc/tasks/tensegrity/task_cable_stand.xml b/mjpc/tasks/tensegrity/task_cable_stand.xml
