<mujoco model="arm_minicell_tensegrity">
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.002" integrator="RK4" gravity="0 0 -9.81"/>

  <default>
    <joint damping="0.6" armature="0.01"/>
    <geom density="850" friction="0.8 0.05 0.02"/>
    <site size="0.006" rgba="0.1 0.8 0.25 1"/>
    <motor ctrllimited="true" ctrlrange="-1 1"/>
    <tendon width="0.006" rgba="0.95 0.1 0.1 1"/>
  </default>

  <worldbody>
    <geom name="floor" type="plane" size="2 2 0.1" rgba="0.96 0.96 0.96 1"/>

    <body name="torso" pos="0 0 1.0">
      <geom name="torso_geom" type="box" size="0.05 0.04 0.10" pos="0 0 0.10" rgba="0.2 0.2 0.25 0.35"/>

      <!-- Shoulder cell: torso-side nodes -->
      <site name="sh_t1" pos="0.045 0.000 0.028"/>
      <site name="sh_t2" pos="-0.022 0.038 0.028"/>
      <site name="sh_t3" pos="-0.022 -0.038 0.028"/>

      <!-- Shoulder-side visible struts -->
      <geom type="box" size="0.004 0.004 0.03" pos="0.032 0.000 0.000" rgba="0.15 0.45 0.85 0.45"/>
      <geom type="box" size="0.004 0.004 0.03" pos="-0.016 0.028 0.000" rgba="0.15 0.45 0.85 0.45"/>
      <geom type="box" size="0.004 0.004 0.03" pos="-0.016 -0.028 0.000" rgba="0.15 0.45 0.85 0.45"/>

      <body name="shoulder_pitch_frame" pos="0 0 0.02">
        <inertial pos="0 0 0" mass="0.01" diaginertia="1e-5 1e-5 1e-5"/>
        <joint name="shoulder_pitch" type="hinge" axis="0 1 0" range="-80 110"/>

        <body name="upper_arm" pos="0 0 0">
          <!-- Shoulder cell: upper-arm-side nodes -->
          <site name="sh_u1" pos="0.038 0.000 -0.015"/>
          <site name="sh_u2" pos="-0.019 0.033 -0.015"/>
          <site name="sh_u3" pos="-0.019 -0.033 -0.015"/>

          <!-- Minimal rigid coupler link: 3 long struts (upper arm) -->
          <geom type="box" size="0.0045 0.0045 0.14" pos="0.024 0.000 -0.155" rgba="0.12 0.44 0.82 0.5"/>
          <geom type="box" size="0.0045 0.0045 0.14" pos="-0.012 0.021 -0.155" rgba="0.12 0.44 0.82 0.5"/>
          <geom type="box" size="0.0045 0.0045 0.14" pos="-0.012 -0.021 -0.155" rgba="0.12 0.44 0.82 0.5"/>

          <!-- Elbow cell: upper-arm-side nodes -->
          <site name="el_u1" pos="0.030 0.000 -0.285"/>
          <site name="el_u2" pos="-0.015 0.026 -0.285"/>
          <site name="el_u3" pos="-0.015 -0.026 -0.285"/>

          <body name="elbow_flex_frame" pos="0 0 -0.30">
            <inertial pos="0 0 0" mass="0.01" diaginertia="1e-5 1e-5 1e-5"/>
            <joint name="elbow_flex" type="hinge" axis="0 1 0" range="0 145"/>

            <body name="forearm" pos="0 0 0">
              <!-- Elbow cell: forearm-side nodes -->
              <site name="el_f1" pos="0.026 0.000 -0.012"/>
              <site name="el_f2" pos="-0.013 0.022 -0.012"/>
              <site name="el_f3" pos="-0.013 -0.022 -0.012"/>

              <!-- Minimal rigid coupler link: 3 long struts (forearm) -->
              <geom type="box" size="0.004 0.004 0.12" pos="0.020 0.000 -0.130" rgba="0.18 0.68 0.50 0.5"/>
              <geom type="box" size="0.004 0.004 0.12" pos="-0.010 0.017 -0.130" rgba="0.18 0.68 0.50 0.5"/>
              <geom type="box" size="0.004 0.004 0.12" pos="-0.010 -0.017 -0.130" rgba="0.18 0.68 0.50 0.5"/>

              <body name="hand" pos="0 0 -0.26">
                <geom type="box" size="0.028 0.020 0.05" pos="0 0 -0.05" rgba="0.9 0.62 0.35 0.35"/>
                <site name="ee" pos="0 0 -0.10" size="0.01" rgba="1 0 0 1"/>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <tendon>
    <!-- Shoulder mini-cell passive network: top ring + cross -->
    <spatial name="sh_r12" stiffness="420" damping="8" springlength="0.072"><site site="sh_t1"/><site site="sh_t2"/></spatial>
    <spatial name="sh_r23" stiffness="420" damping="8" springlength="0.072"><site site="sh_t2"/><site site="sh_t3"/></spatial>
    <spatial name="sh_r31" stiffness="420" damping="8" springlength="0.072"><site site="sh_t3"/><site site="sh_t1"/></spatial>

    <spatial name="sh_c1" stiffness="520" damping="8" springlength="0.090"><site site="sh_t1"/><site site="sh_u2"/></spatial>
    <spatial name="sh_c2" stiffness="520" damping="8" springlength="0.090"><site site="sh_t2"/><site site="sh_u3"/></spatial>
    <spatial name="sh_c3" stiffness="520" damping="8" springlength="0.090"><site site="sh_t3"/><site site="sh_u1"/></spatial>

    <!-- Elbow mini-cell passive network -->
    <spatial name="el_r12" stiffness="360" damping="7" springlength="0.052"><site site="el_u1"/><site site="el_u2"/></spatial>
    <spatial name="el_r23" stiffness="360" damping="7" springlength="0.052"><site site="el_u2"/><site site="el_u3"/></spatial>
    <spatial name="el_r31" stiffness="360" damping="7" springlength="0.052"><site site="el_u3"/><site site="el_u1"/></spatial>

    <spatial name="el_c1" stiffness="480" damping="7" springlength="0.070"><site site="el_u1"/><site site="el_f2"/></spatial>
    <spatial name="el_c2" stiffness="480" damping="7" springlength="0.070"><site site="el_u2"/><site site="el_f3"/></spatial>
    <spatial name="el_c3" stiffness="480" damping="7" springlength="0.070"><site site="el_u3"/><site site="el_f1"/></spatial>

    <!-- Actuated antagonistic tendon pairs (proximal motors + cable transmission abstraction) -->
    <fixed name="t_shoulder_flex"><joint joint="shoulder_pitch" coef="1"/></fixed>
    <fixed name="t_shoulder_ext"><joint joint="shoulder_pitch" coef="-1"/></fixed>

    <fixed name="t_elbow_flex"><joint joint="elbow_flex" coef="1"/></fixed>
    <fixed name="t_elbow_ext"><joint joint="elbow_flex" coef="-1"/></fixed>
  </tendon>

  <actuator>
    <motor name="a_sh_flex" tendon="t_shoulder_flex" gear="34"/>
    <motor name="a_sh_ext" tendon="t_shoulder_ext" gear="34"/>
    <motor name="a_el_flex" tendon="t_elbow_flex" gear="30"/>
    <motor name="a_el_ext" tendon="t_elbow_ext" gear="30"/>
  </actuator>

  <sensor>
    <framepos name="s_ee_pos" objtype="site" objname="ee"/>
  </sensor>

  <keyframe>
    <key name="home" qpos="0 20" ctrl="0 0 0 0"/>
  </keyframe>
</mujoco>
